# ============ SERVER CONFIGURATION ============
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ============ SECURITY CONFIGURATION ============
# CRITICAL: Generate random salt for token encryption
# Run: openssl rand -hex 16
ENCRYPTION_SALT=your_random_salt_32_chars_minimum

# ============ STRIPE CONFIGURATION ============
STRIPE_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Stripe price IDs (from Stripe dashboard)
STRIPE_PRICE_SOLO=price_solo_99
STRIPE_PRICE_PRO=price_pro_349
STRIPE_PRICE_ENTERPRISE=price_enterprise_999

# ============ SUPABASE CONFIGURATION ============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_jwt_secret

# ============ N8N CONFIGURATION ============
N8N_URL=https://arisconsulting.app.n8n.cloud
N8N_API_KEY=your_n8n_api_key

# ============ TWILIO CONFIGURATION ============
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_VOICE=+19187237690
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=http://your-domain.com/api/webhooks/twilio

# ============ CLAUDE API CONFIGURATION ============
CLAUDE_API_KEY=sk-ant-your_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ============ GOOGLE OAUTH CONFIGURATION ============
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback/google

# ============ HUBSPOT OAUTH CONFIGURATION ============
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/oauth/callback/hubspot

# ============ CORS CONFIGURATION ============
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://amiraconsulting.services
CORS_CREDENTIALS=true

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============ LOGGING ============
LOG_LEVEL=info
MORGAN_FORMAT=combined

# ============ DATABASE BACKUP ============
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ============ MONITORING & ALERTS ============
ERROR_RATE_THRESHOLD=0.05
ALERT_EMAIL=admin@amiraconsulting.services
